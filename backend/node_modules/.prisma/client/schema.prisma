datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// CATÁLOGOS INDEPENDIENTES CON BAJA LÓGICA

model Subsistema {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(100)
  activo     Boolean     @default(true)
  aspirantes Aspirante[]

  @@map("subsistema")
}

model Genero {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[]

  @@map("genero")
}

model IdentidadCultural {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(100)
  activo     Boolean     @default(true)
  aspirantes Aspirante[]

  @@map("identidad_cultural")
}

model Discapacidad {
  id         Int                     @id @default(autoincrement())
  nombre     String                  @unique @db.VarChar(100)
  activo     Boolean                 @default(true)
  aspirantes AspiranteDiscapacidad[]

  @@map("discapacidad")
}

model Parentesco {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[]

  @@map("parentesco")
}

model TipoEstudiante {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[]

  @@map("tipo_estudiante")
}

model Semestre {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[]

  @@map("semestre")
}

// TABLA INTERMEDIA PARA DISCAPACIDADES (Muchos a Muchos)
model AspiranteDiscapacidad {
  id             Int          @id @default(autoincrement())
  aspiranteId    Int
  aspirante      Aspirante    @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  discapacidadId Int
  discapacidad   Discapacidad @relation(fields: [discapacidadId], references: [id], onDelete: Cascade)

  @@unique([aspiranteId, discapacidadId])
  @@map("aspirante_discapacidad")
}

// CONTROL DE TIPOS DE USUARIO Y ROLES

model TipoUsuario {
  id          Int     @id @default(autoincrement())
  tipoUsuario String  @map("tipo_usuario") @db.VarChar(50)
  activo      Boolean @default(true)

  usuarios   Usuario[]
  aspirantes Aspirante[]

  @@map("tipo_usuario")
}

model Usuario {
  id              Int         @id @default(autoincrement())
  id_tipoUsuario  Int
  tipoUsuario     TipoUsuario @relation(fields: [id_tipoUsuario], references: [id], onDelete: Restrict)
  correo          String      @unique @db.VarChar(60)
  contrasena      String      @db.VarChar(255)
  nombres         String      @db.VarChar(30)
  apellidoPaterno String      @db.VarChar(30)
  apellidoMaterno String?     @db.VarChar(30)
  activo          Boolean     @default(true)
  creadoEn        DateTime    @default(now())
  updateAt        DateTime    @updatedAt

  auditorias Auditoria[]

  @@map("usuarios")
}

// MODELO PRINCIPAL DE ASPIRANTES Y ALUMNOS

model Aspirante {
  id            Int       @id @default(autoincrement())
  folio         String    @unique @db.VarChar(30)
  vigenciaFolio DateTime?

  matricula      String?     @unique @db.VarChar(15)
  password       String?     @db.VarChar(255)
  tipoUsuarioId  Int         @default(2) @map("tipo_usuario_id")
  tipoUsuarioRel TipoUsuario @relation(fields: [tipoUsuarioId], references: [id], onDelete: Restrict)

  // Campo clave para diferenciar alumnos nuevos (autoservicio) vs. migrados/históricos ("viejitos")
  esMigrado Boolean @default(false) @map("es_migrado")

  apellidoPaterno    String    @db.VarChar(30)
  apellidoMaterno    String?   @db.VarChar(30)
  nombres            String    @db.VarChar(30)
  curp               String    @unique @db.VarChar(18)
  fechaNacimiento    DateTime?
  correoElectronico1 String    @db.VarChar(60)
  correoElectronico2 String?   @db.VarChar(60)
  telefonoCelular    String    @db.VarChar(10)
  telefonoParticular String?   @db.VarChar(10)

  // Relaciones con Catálogos
  generoId            Int?
  generoRel           Genero?                 @relation(fields: [generoId], references: [id])
  identidadCulturalId Int?
  identidadCultural   IdentidadCultural?      @relation(fields: [identidadCulturalId], references: [id])
  discapacidades      AspiranteDiscapacidad[]

  pais           String  @default("MÉXICO") @db.VarChar(50)
  codigoPostal   String? @db.VarChar(10)
  estado         String  @db.VarChar(50)
  municipio      String  @db.VarChar(50)
  colonia        String  @db.VarChar(100)
  calle          String  @db.VarChar(100)
  numeroExterior String? @db.VarChar(10)
  numeroInterior String? @db.VarChar(10)

  tutorApellidoPaterno String?     @db.VarChar(30)
  tutorApellidoMaterno String?     @db.VarChar(30)
  tutorNombres         String?     @db.VarChar(30)
  parentescoTutorId    Int?
  tutorParentescoRel   Parentesco? @relation(fields: [parentescoTutorId], references: [id])
  tutorTelefono        String?     @db.VarChar(10)

  tipoAdmision             String      @db.VarChar(50)
  subsistemaId             Int?
  subsistema               Subsistema? @relation(fields: [subsistemaId], references: [id])
  cctEscuelaProcedencia    String?     @db.VarChar(20)
  nombreEscuelaProcedencia String?     @db.VarChar(150)
  sistemaProcedenciaLetra  String?     @db.VarChar(5)
  otroSistemaProcedencia   String?     @db.VarChar(100)

  semestresSeleccionados Json?

  tipoEstudianteId  Int?
  tipoEstudianteRel TipoEstudiante? @relation(fields: [tipoEstudianteId], references: [id])
  semestreId        Int?
  semestreRel       Semestre?       @relation(fields: [semestreId], references: [id])
  planEstudios      String?         @db.VarChar(50)

  estatusAcademico String @default("ACTIVO_REGULAR") @db.VarChar(50)

  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentos            Documento[]
  historiales           HistorialAcademico[]
  validacionExpedientes ValidacionExpediente?
  pagos                 Pago[]
  materiasInscritas     MateriaInscrita[]
  calificaciones        Calificacion[]

  @@map("aspirante")
}

// SUBMÓDULO DE VALIDACIÓN DE EXPEDIENTES

model ValidacionExpediente {
  id          Int       @id @default(autoincrement())
  aspiranteId Int       @unique
  aspirante   Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)

  dictamenGeneral String    @default("PENDIENTE") @db.VarChar(50)
  observaciones   String?   @db.Text
  validadoPor     String?   @db.VarChar(50)
  fechaValidacion DateTime?

  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("validacion_expedientes")
}

// MODELO DE DOCUMENTOS

model Documento {
  id            Int       @id @default(autoincrement())
  aspiranteId   Int
  aspirante     Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  tipoDoc       String    @db.VarChar(50)
  nombreArchivo String    @db.VarChar(255)
  archivoBlob   Bytes?    @db.LongBlob // Opcional para alumnos migrados antes de subir su documento manual
  estatusDoc    String    @default("PENDIENTE") @db.VarChar(50)
  comentario    String?   @db.Text
  creadoEn      DateTime  @default(now())

  @@map("documento")
}

// AUDITORÍA Y PAGOS

model Auditoria {
  id           Int      @id @default(autoincrement())
  eventoId     String   @unique @db.VarChar(50)
  UsuariosId   Int?
  usuario      Usuario? @relation(fields: [UsuariosId], references: [id], onDelete: SetNull)
  usuarioTexto String?  @db.VarChar(60)
  rol          String?  @db.VarChar(50)
  modulo       String?  @db.VarChar(50)
  accion       String?  @db.VarChar(50)
  detalle      String?  @db.Text
  ip           String?  @db.VarChar(45)
  level        String?  @default("Informativo") @db.VarChar(50)
  creadoEn     DateTime @default(now())

  @@map("auditoria")
}

model Pago {
  id                 Int       @id @default(autoincrement())
  aspiranteId        Int
  aspirante          Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  concepto           String    @db.VarChar(100)
  monto              Float
  referenciaBancaria String    @unique @db.VarChar(100)
  fechaPago          DateTime  @default(now())
  metodo             String    @default("Captura Manual (Ventanilla)") @db.VarChar(100)
  estatus            String    @default("CONCILIADO") @db.VarChar(50)
  creadoEn           DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("pago")
}

// ==========================================
// PLAN DE ESTUDIOS, MATERIAS Y SERIACIÓN
// ==========================================

model PlanEstudio {
  id          Int      @id @default(autoincrement())
  clave       String   @unique @db.VarChar(50)
  nombre      String   @db.VarChar(150)
  descripcion String?  @db.Text
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materias          Materia[]
  historiales       HistorialAcademico[]
  materiasInscritas MateriaInscrita[]
  calificaciones    Calificacion[]

  @@map("plan_estudio")
}

model Materia {
  id             Int         @id @default(autoincrement())
  planEstudioId  Int
  planEstudio    PlanEstudio @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  codigo         String      @db.VarChar(50)
  nombreCompleto String      @map("nombre_completo") @db.VarChar(150)
  nombreCorto    String      @map("nombre_corto") @db.VarChar(100)
  semestre       Int

  prerrequisitos    Seriacion[]          @relation("MateriaPrerrequisito")
  esPrerrequisitoDe Seriacion[]          @relation("MateriaSiguiente")
  historiales       HistorialAcademico[]
  materiasInscritas MateriaInscrita[]
  calificaciones    Calificacion[]

  @@unique([planEstudioId, codigo])
  @@map("materia")
}

model Seriacion {
  id                     Int     @id @default(autoincrement())
  materiaId              Int
  materia                Materia @relation("MateriaPrerrequisito", fields: [materiaId], references: [id], onDelete: Cascade)
  prerrequisitoMateriaId Int
  prerrequisito          Materia @relation("MateriaSiguiente", fields: [prerrequisitoMateriaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, prerrequisitoMateriaId])
  @@map("seriacion")
}

// ==========================================
// REGISTRO ACADÉMICO Y EVALUACIONES
// ==========================================

model MateriaInscrita {
  id            Int         @id @default(autoincrement())
  aspiranteId   Int
  aspirante     Aspirante   @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId     Int
  materia       Materia     @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  planEstudioId Int
  planEstudio   PlanEstudio @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  estatus       String      @default("Cursando") @db.VarChar(50)
  creadoEn      DateTime    @default(now())

  calificaciones Calificacion[]

  @@unique([aspiranteId, materiaId])
  @@map("materia_inscrita")
}

model Calificacion {
  id                Int              @id @default(autoincrement())
  aspiranteId       Int
  aspirante         Aspirante        @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId         Int
  materia           Materia          @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  planEstudioId     Int
  planEstudio       PlanEstudio      @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  materiaInscritaId Int?
  materiaInscrita   MateriaInscrita? @relation(fields: [materiaInscritaId], references: [id], onDelete: SetNull)

  parcial       Int      @default(1)
  calificacion  Int // Calificación entera de 5 a 10
  periodo       String   @db.VarChar(50)
  observaciones String?  @db.Text
  creadoEn      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([aspiranteId, materiaId, parcial, periodo])
  @@map("calificacion")
}

model HistorialAcademico {
  id                    Int         @id @default(autoincrement())
  aspiranteId           Int
  aspirante             Aspirante   @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId             Int
  materia               Materia     @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  planEstudioId         Int
  planEstudio           PlanEstudio @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  calificacion          Int? // Entero de 5 a 10 (5 reprobatoria)
  tipoExamen            String?     @default("F") @db.VarChar(50)
  estatus               String      @default("CURSANDO") @db.VarChar(50)
  planEstudiosCapturado DateTime? // Fecha única de captura

  @@unique([aspiranteId, materiaId])
  @@map("historial_academico")
}

// MÓDULO DE CICLOS ESCOLARES Y CONTROL DE FECHAS

model CicloEscolar {
  id                       Int       @id @default(autoincrement())
  clave                    String    @unique @db.VarChar(45) // Ej: 2026-A
  claveIntersemestral      String?   @db.VarChar(45)
  inicia                   DateTime? @db.Date
  iniciaIntersemestral     DateTime? @db.Date
  termina                  DateTime? @db.Date
  terminaIntersemestral    DateTime? @db.Date
  activo                   Int       @default(1) // 1: Activo/Interruptor general, 0: Inactivo
  fechaConformarExpediente DateTime? @db.Date
  fechaConformarExpEdInter DateTime? @db.Date
  ultimoFolio              String?   @db.VarChar(9)
  ultimoFolioInter         String?   @db.VarChar(9)
  inicioCurso              DateTime? @db.Date
  inicioCursoInter         DateTime? @db.Date
  fechaTaller              DateTime? @db.Date
  fechaTallerInter         DateTime? @db.Date
  creadoEn                 DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("ciclo_escolar")
}
