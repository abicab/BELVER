datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// DIRECTORIO MAESTRO DE CATÁLOGOS
// ==========================================

model Catalogo {
  id            Int     @id @default(autoincrement())
  nombreTabla   String  @unique
  tituloVisible String
  orden         Int     @default(0)
  activo        Boolean @default(true)

  @@map("catalogo")
}

// ==========================================
// TABLAS DE CATÁLOGOS INSTITUCIONALES
// ==========================================

model TipoSecundaria {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("tipo_secundaria")
}

model Subsistema {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("subsistema")
}

model MedioEnterado {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("medio_enterado")
}

model Genero {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("genero")
}

model IdentidadCultural {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("identidad_cultural")
}

model SituacionLaboral {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("situacion_laboral")
}

model Discapacidad {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("discapacidad")
}

model Parentesco {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("parentesco")
}

model TipoEstudiante {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("tipo_estudiante")
}

model Semestre {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("semestre")
}

// ==========================================
// MODELO PRINCIPAL DE ASPIRANTES
// ==========================================

model Aspirante {
  id            Int       @id @default(autoincrement())
  folio         String    @unique
  vigenciaFolio DateTime?

  // Datos Personales y de Contacto
  apellidoPaterno    String
  apellidoMaterno    String?
  nombres            String
  curp               String  @unique
  correoElectronico1 String  @unique
  correoElectronico2 String?
  telefonoCelular    String
  telefonoParticular String?

  // Inclusión y Diversidad
  generoIdentidad   String?
  identidadCultural String?
  tieneDiscapacidad String?
  apoyoEducativo    String?

  // Domicilio (SEPOMEX)
  pais           String  @default("MÉXICO")
  codigoPostal   String
  estado         String
  municipio      String
  colonia        String
  calle          String
  numeroExterior String?
  numeroInterior String?

  // Datos del Tutor
  tutorApellidoPaterno String?
  tutorApellidoMaterno String?
  tutorNombres         String?
  tutorParentesco      String?
  tutorTelefono        String?

  // Modalidad y Antecedentes Académicos
  tipoAdmision             String
  tipoSecundaria           String?
  cctEscuelaProcedencia    String?
  nombreEscuelaProcedencia String?
  estadoEscuelaProcedencia String?
  promedioSecundaria       String?

  // Historial de Bachillerato (Revalidación)
  sistemaBachilleratoPrevio String?
  otroSistemaProcedencia    String?
  cctBachilleratoPrevio     String?
  nombreBachilleratoPrevio  String?
  estadoBachilleratoPrevio  String?
  tipoEstudiante            String?
  semestreActual            String?
  planEstudios              String?

  // Perfil Tecnológico y Estadística
  situacionLaboral  String?
  cuentaComputadora String?
  cuentaInternet    String?
  medioEnterado     String?

  // Fechas del Sistema
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  documentos  Documento[]
  historiales HistorialAcademico[] // <-- AQUÍ ESTÁ LA RELACIÓN QUE FALTABA

  @@map("aspirante")
}

// ==========================================
// MODELO DE DOCUMENTOS (Expediente Digital)
// ==========================================

model Documento {
  id            Int       @id @default(autoincrement())
  aspiranteId   Int
  aspirante     Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  tipoDoc       String
  nombreArchivo String
  archivoBlob   Bytes
  estatusDoc    String    @default("EN REVISIÓN")
  creadoEn      DateTime  @default(now())

  @@map("documento")
}

// ==========================================
// PLANES DE ESTUDIO Y ESTRUCTURA CURRICULAR
// ==========================================

model PlanEstudio {
  id            Int      @id @default(autoincrement())
  clave         String   @unique
  nombre        String
  acuerdoSep    String
  totalCreditos Int
  descripcion   String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  materias Materia[]

  @@map("plan_estudio")
}

model Materia {
  id            Int         @id @default(autoincrement())
  planEstudioId Int
  planEstudio   PlanEstudio @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  codigo        String
  nombre        String
  semestre      Int // 1 a 6
  modulo        Int         @default(1) // Módulo dentro del semestre (1 u 2)
  creditos      Int         @default(6)

  // Seriación / Prerrequisitos
  prerrequisitos    Seriacion[] @relation("MateriaPrerrequisito")
  esPrerrequisitoDe Seriacion[] @relation("MateriaSiguiente")

  historiales HistorialAcademico[]

  @@unique([planEstudioId, codigo])
  @@map("materia")
}

model Seriacion {
  id                     Int     @id @default(autoincrement())
  materiaId              Int
  materia                Materia @relation("MateriaPrerrequisito", fields: [materiaId], references: [id], onDelete: Cascade)
  prerrequisitoMateriaId Int
  prerrequisito          Materia @relation("MateriaSiguiente", fields: [prerrequisitoMateriaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, prerrequisitoMateriaId])
  @@map("seriacion")
}

model HistorialAcademico {
  id           Int       @id @default(autoincrement())
  aspiranteId  Int
  aspirante    Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId    Int
  materia      Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  calificacion Float?
  tipoExamen   String?   @default("F") // F: Final, R: Regularización
  estatus      String    @default("CURSANDO") // APROBADA, REPROBADA, CURSANDO
  periodo      String?

  @@unique([aspiranteId, materiaId])
  @@map("historial_academico")
}
