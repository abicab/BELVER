datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// DIRECTORIO MAESTRO DE CATÁLOGOS (Control del Admin)
// ==========================================

model Catalogo {
  id            Int     @id @default(autoincrement())
  nombreTabla   String  @unique // Identificador técnico (ej. "genero", "tipo_secundaria")
  tituloVisible String // Nombre amigable para la interfaz (ej. "Género de Identidad")
  orden         Int     @default(0)
  activo        Boolean @default(true)

  @@map("catalogo")
}

// ==========================================
// TABLAS DE CATÁLOGOS INSTITUCIONALES
// ==========================================

model TipoSecundaria {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("TipoSecundariaRel")

  @@map("tipo_secundaria")
}

model Subsistema {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("SubsistemaRel")

  @@map("subsistema")
}

model MedioEnterado {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("MedioEnteradoRel")

  @@map("medio_enterado")
}

model Genero {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("GeneroRel")

  @@map("genero")
}

model IdentidadCultural {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("IdentidadCulturalRel")

  @@map("identidad_cultural")
}

model SituacionLaboral {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("SituacionLaboralRel")

  @@map("situacion_laboral")
}

model Discapacidad {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("DiscapacidadRel")

  @@map("discapacidad")
}

model Parentesco {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("ParentescoRel")

  @@map("parentesco")
}

model TipoEstudiante {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("TipoEstudianteRel")

  @@map("tipo_estudiante")
}

model Semestre {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("SemestreRel")

  @@map("semestre")
}

// ==========================================
// USUARIOS ADMINISTRATIVOS (Control Escolar / Admin)
// ==========================================

model UsuarioAdmin {
  id        Int      @id @default(autoincrement())
  correo    String   @unique
  password  String // Contraseña hasheada (bcrypt)
  nombres   String
  apellidos String
  rol       String   @default("OPERADOR_ESCOLAR") // ADMINISTRADOR, OPERADOR, DIRECTOR
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditorias Auditoria[]

  @@map("usuario_admin")
}

// ==========================================
// MODELO PRINCIPAL DE ASPIRANTES Y ALUMNOS
// ==========================================

model Aspirante {
  id            Int       @id @default(autoincrement())
  folio         String    @unique
  vigenciaFolio DateTime?

  // CREDENCIALES DE ACCESO INSTITUCIONAL
  matricula String? @unique // Formato: B26000001
  password  String? // Contraseña segura generada (visible para admin)
  rol       String  @default("ASPIRANTE") // ASPIRANTE, ALUMNO, ADMIN

  // Datos Personales y de Contacto
  apellidoPaterno    String
  apellidoMaterno    String?
  nombres            String
  curp               String  @unique
  correoElectronico1 String  @unique
  correoElectronico2 String?
  telefonoCelular    String
  telefonoParticular String?

  // Inclusión y Diversidad (Relaciones con Catálogos)
  generoId Int?
  genero   Genero? @relation("GeneroRel", fields: [generoId], references: [id])

  identidadCulturalId Int?
  identidadCultural   IdentidadCultural? @relation("IdentidadCulturalRel", fields: [identidadCulturalId], references: [id])

  discapacidadId Int?
  discapacidad   Discapacidad? @relation("DiscapacidadRel", fields: [discapacidadId], references: [id])

  apoyoEducativo String?

  // Domicilio (SEPOMEX)
  pais           String  @default("MÉXICO")
  codigoPostal   String
  estado         String
  municipio      String
  colonia        String
  calle          String
  numeroExterior String?
  numeroInterior String?

  // Datos del Tutor
  tutorApellidoPaterno String?
  tutorApellidoMaterno String?
  tutorNombres         String?

  parentescoTutorId  Int?
  tutorParentescoRel Parentesco? @relation("ParentescoRel", fields: [parentescoTutorId], references: [id])

  tutorTelefono String?

  // Modalidad y Antecedentes Académicos
  tipoAdmision String

  tipoSecundariaId  Int?
  tipoSecundariaRel TipoSecundaria? @relation("TipoSecundariaRel", fields: [tipoSecundariaId], references: [id])

  subsistemaId Int?
  subsistema   Subsistema? @relation("SubsistemaRel", fields: [subsistemaId], references: [id])

  cctEscuelaProcedencia    String?
  nombreEscuelaProcedencia String?
  estadoEscuelaProcedencia String?
  promedioSecundaria       String?

  // Historial de Bachillerato (Revalidación)
  sistemaBachilleratoPrevio String?
  otroSistemaProcedencia    String?
  cctBachilleratoPrevio     String?
  nombreBachilleratoPrevio  String?
  estadoBachilleratoPrevio  String?

  tipoEstudianteId  Int?
  tipoEstudianteRel TipoEstudiante? @relation("TipoEstudianteRel", fields: [tipoEstudianteId], references: [id])

  semestreId  Int?
  semestreRel Semestre? @relation("SemestreRel", fields: [semestreId], references: [id])

  planEstudios String?

  // Perfil Tecnológico y Estadística
  situacionLaboralId  Int?
  situacionLaboralRel SituacionLaboral? @relation("SituacionLaboralRel", fields: [situacionLaboralId], references: [id])

  cuentaComputadora String?
  cuentaInternet    String?

  medioEnteradoId  Int?
  medioEnteradoRel MedioEnterado? @relation("MedioEnteradoRel", fields: [medioEnteradoId], references: [id])

  // Datos específicos para CAE (Seguimiento Estudiantil)
  estatusAcademico   String  @default("ACTIVO_REGULAR") // ACTIVO_REGULAR, RECURSAMIENTO, BAJA_TEMPORAL
  emergenciaContacto String?
  emergenciaTelefono String?

  // Fechas del Sistema
  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones Operativas
  documentos        Documento[]
  historiales       HistorialAcademico[]
  controlEscolar    ControlEscolar?
  pagos             Pago[]
  materiasInscritas MateriaInscrita[]

  @@map("aspirante")
}

// ==========================================
// MÓDULO DE CONTROL ESCOLAR (Expediente Administrativo)
// ==========================================

model ControlEscolar {
  id          Int       @id @default(autoincrement())
  aspiranteId Int       @unique // Relación 1 a 1 estricta con el Aspirante/Alumno
  aspirante   Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)

  dictamenGeneral String    @default("PENDIENTE") // PENDIENTE, APROBADO, CON_OBSERVACIONES
  observaciones   String?   @db.Text
  validadoPor     String?
  fechaValidacion DateTime?

  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("control_escolar")
}

// ==========================================
// MODELO DE DOCUMENTOS (Expediente Digital)
// ==========================================

model Documento {
  id            Int       @id @default(autoincrement())
  aspiranteId   Int
  aspirante     Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  tipoDoc       String
  nombreArchivo String
  archivoBlob   Bytes
  estatusDoc    String    @default("EN REVISIÓN")
  creadoEn      DateTime  @default(now())

  @@map("documento")
}

// ==========================================
// MÓDULO DE AUDITORÍA Y LOGS (Retención de 3 meses)
// ==========================================

model Auditoria {
  id             Int           @id @default(autoincrement())
  eventoId       String        @unique // Ej. LOG-8012
  usuarioAdminId Int?
  usuarioAdmin   UsuarioAdmin? @relation(fields: [usuarioAdminId], references: [id], onDelete: SetNull)
  usuarioTexto   String?
  rol            String?
  modulo         String // Seguridad / Auth, Control Escolar, Pagos, CAE, etc.
  accion         String // Inicio de Sesión, Cambio de Estatus, Modificación, etc.
  detalle        String        @db.Text
  ip             String?
  nivel          String        @default("Informativo") // Informativo, Alerta, Crítico
  creadoEn       DateTime      @default(now()) // Base para purga automática de 3 meses

  @@map("auditoria")
}

// ==========================================
// MÓDULO DE PAGOS Y CAJA (Constancias y Credenciales)
// ==========================================

model Pago {
  id                 Int       @id @default(autoincrement())
  aspiranteId        Int // Llave foránea estricta con el alumno
  aspirante          Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  concepto           String // "Emisión de Credencial Escolar", "Constancia de Estudios", etc.
  monto              Float // Ej. 150.00 o 85.00
  referenciaBancaria String    @unique
  fechaPago          DateTime  @default(now())
  metodo             String    @default("Captura Manual (Ventanilla)") // Archivo Bancario (Layout) o Captura Manual
  estatus            String    @default("CONCILIADO") // CONCILIADO, PENDIENTE
  creadoEn           DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("pago")
}

// ==========================================
// PLANES DE ESTUDIO Y ESTRUCTURA CURRICULAR (Parte de tu compañero - Intacta)
// ==========================================

model PlanEstudio {
  id            Int      @id @default(autoincrement())
  clave         String   @unique
  nombre        String
  acuerdoSep    String
  totalCreditos Int
  descripcion   String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  materias Materia[]

  @@map("plan_estudio")
}

model Materia {
  id            Int         @id @default(autoincrement())
  planEstudioId Int
  planEstudio   PlanEstudio @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  codigo        String
  nombre        String
  semestre      Int // 1 a 6
  modulo        Int         @default(1) // Módulo dentro del semestre (1 u 2)
  creditos      Int         @default(6)

  prerrequisitos    Seriacion[] @relation("MateriaPrerrequisito")
  esPrerrequisitoDe Seriacion[] @relation("MateriaSiguiente")

  historiales       HistorialAcademico[]
  materiasInscritas MateriaInscrita[]

  @@unique([planEstudioId, codigo])
  @@map("materia")
}

model Seriacion {
  id                     Int     @id @default(autoincrement())
  materiaId              Int
  materia                Materia @relation("MateriaPrerrequisito", fields: [materiaId], references: [id], onDelete: Cascade)
  prerrequisitoMateriaId Int
  prerrequisito          Materia @relation("MateriaSiguiente", fields: [prerrequisitoMateriaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, prerrequisitoMateriaId])
  @@map("seriacion")
}

model HistorialAcademico {
  id           Int       @id @default(autoincrement())
  aspiranteId  Int
  aspirante    Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId    Int
  materia      Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  calificacion Float?
  tipoExamen   String?   @default("F") // F: Final, R: Regularización
  estatus      String    @default("CURSANDO") // APROBADA, REPROBADA, CURSANDO
  periodo      String?

  @@unique([aspiranteId, materiaId])
  @@map("historial_academico")
}

// ==========================================
// MÓDULO CAE (Materias activas del semestre actual)
// ==========================================

model MateriaInscrita {
  id          Int       @id @default(autoincrement())
  aspiranteId Int
  aspirante   Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId   Int
  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  estatus     String    @default("Cursando") // Cursando, Recursando, Acreditado
  creadoEn    DateTime  @default(now())

  @@unique([aspiranteId, materiaId])
  @@map("materia_inscrita")
}
