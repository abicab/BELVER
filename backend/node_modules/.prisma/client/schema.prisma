datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Aspirante {
  id                        Int      @id @default(autoincrement())
  folio                     String   @unique
  vigenciaFolio             DateTime
  apellidoPaterno           String
  apellidoMaterno           String?
  nombres                   String
  curp                      String   @unique
  correoElectronico1        String   @unique
  correoElectronico2        String?
  telefonoCelular           String
  telefonoParticular        String?
  generoIdentidad           String?
  identidadCultural         String?
  tieneDiscapacidad         String   @default("NO")
  apoyoEducativo            String   @default("NO")
  situacionLaboral          String?
  cuentaComputadora         String   @default("SÍ")
  cuentaInternet            String   @default("SÍ")
  medioEnterado             String?
  pais                      String   @default("MÉXICO")
  codigoPostal              String
  estado                    String
  municipio                 String
  colonia                   String
  calle                     String
  numeroExterior            String?
  numeroInterior            String?
  tutorApellidoPaterno      String?
  tutorApellidoMaterno      String?
  tutorNombres              String?
  tutorParentesco           String?
  tutorTelefono             String?
  tipoAdmision              String   @default("nuevo_ingreso")
  tipoSecundaria            String?
  cctEscuelaProcedencia     String?
  nombreEscuelaProcedencia  String?
  estadoEscuelaProcedencia  String?
  promedioSecundaria        String?
  sistemaBachilleratoPrevio String?
  otroSistemaProcedencia    String?
  cctBachilleratoPrevio     String?
  nombreBachilleratoPrevio  String?
  estadoBachilleratoPrevio  String?
  tipoEstudiante            String?
  semestreActual            String?
  planEstudios              String?
  creadoEn                  DateTime @default(now())
  actualizadoEn             DateTime @updatedAt

  documentos Documento[]

  @@map("aspirantes")
}

model Documento {
  id            Int       @id @default(autoincrement())
  aspiranteId   Int
  aspirante     Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  tipoDoc       String
  nombreArchivo String
  rutaArchivo   String
  estatusDoc    String    @default("EN REVISIÓN")
  creadoEn      DateTime  @default(now())

  @@map("documentos")
}

model TipoSecundariaCatalog {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(150)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("tipos_secundaria_catalog")
}

model SubsistemaBachilleratoCatalog {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(150)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("subsistemas_bachillerato_catalog")
}

model MedioEnteradoCatalog {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(150)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("medios_enterado_catalog")
}

model GeneroIdentidadCatalog {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(150)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("genero_identidad_catalog")
}

model IdentidadCulturalCatalog {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(150)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("identidad_cultural_catalog")
}

model SituacionLaboralCatalog {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(150)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("situacion_laboral_catalog")
}

model DiscapacidadCatalog {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("discapacidad_catalog")
}
