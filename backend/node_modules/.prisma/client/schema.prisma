datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// DIRECTORIO MAESTRO DE CATÁLOGOS (Control del Admin)
// ==========================================

model Catalogo {
  id            Int     @id @default(autoincrement())
  nombreTabla   String  @unique @db.VarChar(50)
  tituloVisible String  @db.VarChar(50)
  orden         Int     @default(0)
  activo        Boolean @default(true)

  @@map("catalogo")
}

// ==========================================
// TABLAS DE CATÁLOGOS INSTITUCIONALES
// ==========================================

model Subsistema {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("SubsistemaRel")

  @@map("subsistema")
}

model Genero {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("GeneroRel")

  @@map("genero")
}

model IdentidadCultural {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("IdentidadCulturalRel")

  @@map("identidad_cultural")
}

model Discapacidad {
  id         Int                     @id @default(autoincrement())
  nombre     String                  @unique @db.VarChar(50)
  activo     Boolean                 @default(true)
  aspirantes AspiranteDiscapacidad[]

  @@map("discapacidad")
}

model AspiranteDiscapacidad {
  id             Int          @id @default(autoincrement())
  aspiranteId    Int
  aspirante      Aspirante    @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  discapacidadId Int
  discapacidad   Discapacidad @relation(fields: [discapacidadId], references: [id], onDelete: Cascade)

  @@unique([aspiranteId, discapacidadId])
  @@map("aspirante_discapacidad")
}

model Parentesco {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("ParentescoRel")

  @@map("parentesco")
}

model TipoEstudiante {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("TipoEstudianteRel")

  @@map("tipo_estudiante")
}

model Semestre {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("SemestreRel")

  @@map("semestre")
}

// ==========================================
// CONTROL DE TIPOS DE USUARIO Y ROLES
// ==========================================

model TipoUsuario {
  id          Int     @id @default(autoincrement())
  tipoUsuario String  @map("tipo_usuario") @db.VarChar(50) // Ej: ASPIRANTE, ALUMNO, CONTROL_ESCOLAR, ADMIN
  activo      Boolean @default(true)

  usuarios   Usuario[]
  aspirantes Aspirante[]

  @@map("tipo_usuario")
}

model Usuario {
  id              Int         @id @default(autoincrement())
  id_tipoUsuario  Int
  tipoUsuario     TipoUsuario @relation(fields: [id_tipoUsuario], references: [id], onDelete: Restrict)
  correo          String      @unique @db.VarChar(50)
  contrasena      String      @db.VarChar(255)
  nombres         String      @db.VarChar(50)
  apellidoPaterno String      @db.VarChar(50)
  apellidoMaterno String?     @db.VarChar(50)
  activo          Boolean     @default(true)
  creadoEn        DateTime    @default(now())
  updateAt        DateTime    @updatedAt

  auditorias Auditoria[]

  @@map("usuarios")
}

// ==========================================
// MODELO PRINCIPAL DE ASPIRANTES Y ALUMNOS
// ==========================================

model Aspirante {
  id            Int       @id @default(autoincrement())
  folio         String    @unique @db.VarChar(50)
  vigenciaFolio DateTime?

  // CREDENCIALES Y ROL ASOCIADO
  matricula      String?     @unique @db.VarChar(50)
  password       String?     @db.VarChar(255)
  tipoUsuarioId  Int         @default(2) @map("tipo_usuario_id")
  tipoUsuarioRel TipoUsuario @relation(fields: [tipoUsuarioId], references: [id], onDelete: Restrict)

  // Datos Personales y de Contacto
  apellidoPaterno    String    @db.VarChar(50)
  apellidoMaterno    String?   @db.VarChar(50)
  nombres            String    @db.VarChar(50)
  curp               String    @unique @db.VarChar(50)
  fechaNacimiento    DateTime?
  correoElectronico1 String    @db.VarChar(50)
  correoElectronico2 String?   @db.VarChar(50)
  telefonoCelular    String    @db.VarChar(50)
  telefonoParticular String?   @db.VarChar(50)

  // Inclusión y Diversidad
  generoId            Int?
  generoRel           Genero?                 @relation("GeneroRel", fields: [generoId], references: [id])
  identidadCulturalId Int?
  identidadCultural   IdentidadCultural?      @relation("IdentidadCulturalRel", fields: [identidadCulturalId], references: [id])
  discapacidades      AspiranteDiscapacidad[]

  // Domicilio
  pais           String  @default("MÉXICO") @db.VarChar(50)
  codigoPostal   String? @db.VarChar(50)
  estado         String  @db.VarChar(50)
  municipio      String  @db.VarChar(50)
  colonia        String  @db.VarChar(50)
  calle          String  @db.VarChar(50)
  numeroExterior String? @db.VarChar(50)
  numeroInterior String? @db.VarChar(50)

  // Datos del Tutor
  tutorApellidoPaterno String?     @db.VarChar(50)
  tutorApellidoMaterno String?     @db.VarChar(50)
  tutorNombres         String?     @db.VarChar(50)
  parentescoTutorId    Int?
  tutorParentescoRel   Parentesco? @relation("ParentescoRel", fields: [parentescoTutorId], references: [id])
  tutorTelefono        String?     @db.VarChar(50)

  // Antecedentes Académicos Unificados y Simplificados
  tipoAdmision             String      @db.VarChar(50) // "nuevo_ingreso" o "revalidacion"
  subsistemaId             Int?
  subsistema               Subsistema? @relation("SubsistemaRel", fields: [subsistemaId], references: [id])
  cctEscuelaProcedencia    String?     @db.VarChar(50)
  nombreEscuelaProcedencia String?     @db.VarChar(50)

  // Campos específicos de equivalencias
  sistemaProcedenciaLetra String? @db.VarChar(50)
  otroSistemaProcedencia  String? @db.VarChar(50)

  // Control Escolar Interno
  tipoEstudianteId  Int?
  tipoEstudianteRel TipoEstudiante? @relation("TipoEstudianteRel", fields: [tipoEstudianteId], references: [id])
  semestreId        Int?
  semestreRel       Semestre?       @relation("SemestreRel", fields: [semestreId], references: [id])
  planEstudios      String?         @db.VarChar(50)

  estatusAcademico String @default("ACTIVO_REGULAR") @db.VarChar(50)

  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones Operativas Actualizadas
  documentos            Documento[]
  historiales           HistorialAcademico[]
  validacionExpedientes ValidacionExpediente?
  pagos                 Pago[]
  materiasInscritas     MateriaInscrita[]

  @@map("aspirante")
}

// ==========================================
// SUBMÓDULO DE VALIDACIÓN DE EXPEDIENTES
// ==========================================

model ValidacionExpediente {
  id          Int       @id @default(autoincrement())
  aspiranteId Int       @unique
  aspirante   Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)

  dictamenGeneral String    @default("PENDIENTE") @db.VarChar(50)
  observaciones   String?   @db.Text
  validadoPor     String?   @db.VarChar(50)
  fechaValidacion DateTime?

  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("validacion_expedientes")
}

// ==========================================
// MODELO DE DOCUMENTOS
// ==========================================

model Documento {
  id            Int       @id @default(autoincrement())
  aspiranteId   Int
  aspirante     Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  tipoDoc       String    @db.VarChar(50)
  nombreArchivo String    @db.VarChar(50)
  archivoBlob   Bytes
  estatusDoc    String    @default("EN REVISIÓN") @db.VarChar(50)
  creadoEn      DateTime  @default(now())

  @@map("documento")
}

model Auditoria {
  id           Int      @id @default(autoincrement())
  eventoId     String   @unique @db.VarChar(50)
  UsuariosId   Int?
  usuario      Usuario? @relation(fields: [UsuariosId], references: [id], onDelete: SetNull)
  usuarioTexto String?  @db.VarChar(50)
  rol          String?  @db.VarChar(50)
  modulo       String   @db.VarChar(50)
  accion       String   @db.VarChar(50)
  detalle      String   @db.Text
  ip           String?  @db.VarChar(50)
  level        String   @default("Informativo") @db.VarChar(50)
  creadoEn     DateTime @default(now())

  @@map("auditoria")
}

model Pago {
  id                 Int       @id @default(autoincrement())
  aspiranteId        Int
  aspirante          Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  concepto           String    @db.VarChar(50)
  monto              Float
  referenciaBancaria String    @unique @db.VarChar(50)
  fechaPago          DateTime  @default(now())
  metodo             String    @default("Captura Manual (Ventanilla)") @db.VarChar(50)
  estatus            String    @default("CONCILIADO") @db.VarChar(50)
  creadoEn           DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("pago")
}

model PlanEstudio {
  id          Int       @id @default(autoincrement())
  clave       String    @unique @db.VarChar(50)
  nombre      String    @db.VarChar(50)
  descripcion String?   @db.Text
  activo      Boolean   @default(true)
  creadoEn    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  materias    Materia[]

  @@map("plan_estudio")
}

model Materia {
  id             Int         @id @default(autoincrement())
  planEstudioId  Int
  planEstudio    PlanEstudio @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  codigo         String      @db.VarChar(50)
  nombreCompleto String      @map("nombre_completo") @db.VarChar(50)
  nombreCorto    String      @map("nombre_corto") @db.VarChar(50)
  semestre       Int

  prerrequisitos    Seriacion[]          @relation("MateriaPrerrequisito")
  esPrerrequisitoDe Seriacion[]          @relation("MateriaSiguiente")
  historiales       HistorialAcademico[]
  materiasInscritas MateriaInscrita[]

  @@unique([planEstudioId, codigo])
  @@map("materia")
}

model Seriacion {
  id                     Int     @id @default(autoincrement())
  materiaId              Int
  materia                Materia @relation("MateriaPrerrequisito", fields: [materiaId], references: [id], onDelete: Cascade)
  prerrequisitoMateriaId Int
  prerrequisito          Materia @relation("MateriaSiguiente", fields: [prerrequisitoMateriaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, prerrequisitoMateriaId])
  @@map("seriacion")
}

model HistorialAcademico {
  id           Int       @id @default(autoincrement())
  aspiranteId  Int
  aspirante    Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId    Int
  materia      Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  calificacion Float?
  tipoExamen   String?   @default("F") @db.VarChar(50)
  estatus      String    @default("CURSANDO") @db.VarChar(50)
  periodo      String?   @db.VarChar(50)

  @@unique([aspiranteId, materiaId])
  @@map("historial_academico")
}

model MateriaInscrita {
  id          Int       @id @default(autoincrement())
  aspiranteId Int
  aspirante   Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId   Int
  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  estatus     String    @default("Cursando") @db.VarChar(50)
  creadoEn    DateTime  @default(now())

  @@unique([aspiranteId, materiaId])
  @@map("materia_inscrita")
}
