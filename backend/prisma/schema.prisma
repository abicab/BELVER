datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// DIRECTORIO MAESTRO DE CATÁLOGOS (Control del Admin)
// ==========================================

model Catalogo {
  id              Int     @id @default(autoincrement())
  nombreTabla     String  @unique
  tituloVisible   String
  orden           Int     @default(0)
  activo          Boolean @default(true)

  @@map("catalogo")
}

// ==========================================
// TABLAS DE CATÁLOGOS INSTITUCIONALES
// ==========================================

model Subsistema {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("SubsistemaRel")

  @@map("subsistema")
}

model Genero {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("GeneroRel")

  @@map("genero")
}

model IdentidadCultural {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("IdentidadCulturalRel")

  @@map("identidad_cultural")
}

model Discapacidad {
  id         Int                     @id @default(autoincrement())
  nombre     String                  @unique
  activo     Boolean                 @default(true)
  aspirantes AspiranteDiscapacidad[]

  @@map("discapacidad")
}

// Tabla intermedia para soportar múltiples discapacidades por aspirante
model AspiranteDiscapacidad {
  id             Int          @id @default(autoincrement())
  aspiranteId    Int
  aspirante      Aspirante    @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  discapacidadId Int
  discapacidad   Discapacidad @relation(fields: [discapacidadId], references: [id], onDelete: Cascade)

  @@unique([aspiranteId, discapacidadId])
  @@map("aspirante_discapacidad")
}

model Parentesco {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("ParentescoRel")

  @@map("parentesco")
}

model TipoEstudiante {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("TipoEstudianteRel")

  @@map("tipo_estudiante")
}

model Semestre {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  activo     Boolean     @default(true)
  aspirantes Aspirante[] @relation("SemestreRel")

  @@map("semestre")
}

// ==========================================
// CONTROL DE TIPOS DE USUARIO Y USUARIOS
// ==========================================

model TipoUsuario {
  id          Int     @id @default(autoincrement())
  tipoUsuario String  @map("tipo_usuario")
  activo      Boolean @default(true)

  usuarios    Usuario[]

  @@map("tipo_usuario")
}

model Usuario {
  id              Int         @id @default(autoincrement())
  id_tipoUsuario  Int
  tipoUsuario     TipoUsuario @relation(fields: [id_tipoUsuario], references: [id], onDelete: Restrict)
  correo          String      @unique
  contrasena      String
  nombres         String
  apellidoPaterno String
  apellidoMaterno String?
  activo          Boolean     @default(true)
  creadoEn        DateTime    @default(now())
  updateAt        DateTime    @updatedAt

  auditorias      Auditoria[]

  @@map("usuarios")
}

// ==========================================
// MODELO PRINCIPAL DE ASPIRANTES Y ALUMNOS
// ==========================================

model Aspirante {
  id                 Int       @id @default(autoincrement())
  folio              String    @unique
  vigenciaFolio      DateTime?

  // CREDENCIALES DE ACCESO INSTITUCIONAL
  matricula          String?   @unique
  password           String?
  rol                String    @default("ASPIRANTE")

  // Datos Personales y de Contacto
  apellidoPaterno     String
  apellidoMaterno     String?
  nombres             String
  curp                String    @unique
  fechaNacimiento     DateTime?
  genero              String?
  correoElectronico1  String    @unique
  correoElectronico2  String?
  telefonoCelular     String
  telefonoParticular  String?

  // Inclusión y Diversidad (Relaciones con Catálogos)
  generoId            Int?
  generoRel           Genero?   @relation("GeneroRel", fields: [generoId], references: [id])

  identidadCulturalId Int?
  identidadCultural   IdentidadCultural? @relation("IdentidadCulturalRel", fields: [identidadCulturalId], references: [id])

  discapacidades      AspiranteDiscapacidad[]

  // Domicilio (SEPOMEX con código postal opcional para extranjeros)
  pais                String    @default("MÉXICO")
  codigoPostal        String?
  estado              String
  municipio           String
  colonia             String
  calle               String
  numeroExterior      String?
  numeroInterior      String?

  // Datos del Tutor
  tutorApellidoPaterno String?
  tutorApellidoMaterno String?
  tutorNombres         String?

  parentescoTutorId    Int?
  tutorParentescoRel   Parentesco? @relation("ParentescoRel", fields: [parentescoTutorId], references: [id])

  tutorTelefono        String?

  // Modalidad y Antecedentes Académicos
  tipoAdmision         String

  subsistemaId         Int?
  subsistema           Subsistema? @relation("SubsistemaRel", fields: [subsistemaId], references: [id])

  cctEscuelaProcedencia      String?
  nombreEscuelaProcedencia   String?
  estadoEscuelaProcedencia   String?
  promedioSecundaria         String?

  // Historial de Bachillerato (Revalidación)
  sistemaBachilleratoPrevio  String?
  sistemaProcedenciaLetra    String?
  otroSistemaProcedencia     String?
  cctBachilleratoPrevio      String?
  nombreBachilleratoPrevio   String?
  estadoBachilleratoPrevio   String?

  tipoEstudianteId     Int?
  tipoEstudianteRel    TipoEstudiante? @relation("TipoEstudianteRel", fields: [tipoEstudianteId], references: [id])

  semestreId           Int?
  semestreRel          Semestre? @relation("SemestreRel", fields: [semestreId], references: [id])

  planEstudios         String?

  estatusAcademico     String    @default("ACTIVO_REGULAR")
  emergenciaContacto   String?
  emergenciaTelefono   String?

  // Fechas del Sistema
  creadoEn             DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relaciones Operativas
  documentos           Documento[]
  historiales          HistorialAcademico[]
  controlEscolar       ControlEscolar?
  pagos                Pago[]
  materiasInscritas    MateriaInscrita[]

  @@map("aspirante")
}

// ==========================================
// MÓDULO DE CONTROL ESCOLAR (Expediente Administrativo)
// ==========================================

model ControlEscolar {
  id              Int       @id @default(autoincrement())
  aspiranteId     Int       @unique
  aspirante       Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)

  dictamenGeneral String    @default("PENDIENTE")
  observaciones   String?   @db.Text
  validadoPor     String?
  fechaValidacion DateTime?

  creadoEn        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("control_escolar")
}

// ==========================================
// MODELO DE DOCUMENTOS (Expediente Digital)
// ==========================================

model Documento {
  id            Int       @id @default(autoincrement())
  aspiranteId   Int
  aspirante     Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  tipoDoc       String
  nombreArchivo String
  archivoBlob   Bytes
  estatusDoc    String    @default("EN REVISIÓN")
  creadoEn      DateTime  @default(now())

  @@map("documento")
}

// ==========================================
// MÓDULO DE AUDITORÍA Y LOGS
// ==========================================

model Auditoria {
  id           Int      @id @default(autoincrement())
  eventoId     String   @unique
  UsuariosId   Int?
  usuario      Usuario? @relation(fields: [UsuariosId], references: [id], onDelete: SetNull)
  usuarioTexto String?
  rol          String?
  modulo       String
  accion       String
  detalle      String        @db.Text
  ip           String?
  nivel        String        @default("Informativo")
  creadoEn     DateTime      @default(now())

  @@map("auditoria")
}

// ==========================================
// MÓDULO DE PAGOS Y CAJA
// ==========================================

model Pago {
  id                 Int       @id @default(autoincrement())
  aspiranteId        Int
  aspirante          Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  concepto           String
  monto              Float
  referenciaBancaria String    @unique
  fechaPago          DateTime  @default(now())
  metodo             String    @default("Captura Manual (Ventanilla)")
  estatus            String    @default("CONCILIADO")
  creadoEn           DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("pago")
}

// ==========================================
// PLANES DE ESTUDIO Y ESTRUCTURA CURRICULAR
// ==========================================

model PlanEstudio {
  id          Int      @id @default(autoincrement())
  clave       String   @unique
  nombre      String
  descripcion String?  @db.Text
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materias    Materia[]

  @@map("plan_estudio")
}

model Materia {
  id             Int         @id @default(autoincrement())
  planEstudioId  Int
  planEstudio    PlanEstudio @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  codigo         String
  nombreCompleto String      @map("nombre_completo")
  nombreCorto    String      @map("nombre_corto")
  semestre       Int

  prerrequisitos    Seriacion[] @relation("MateriaPrerrequisito")
  esPrerrequisitoDe Seriacion[] @relation("MateriaSiguiente")

  historiales       HistorialAcademico[]
  materiasInscritas MateriaInscrita[]

  @@unique([planEstudioId, codigo])
  @@map("materia")
}

model Seriacion {
  id                     Int     @id @default(autoincrement())
  materiaId              Int
  materia                Materia @relation("MateriaPrerrequisito", fields: [materiaId], references: [id], onDelete: Cascade)
  prerrequisitoMateriaId Int
  prerrequisito          Materia @relation("MateriaSiguiente", fields: [prerrequisitoMateriaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, prerrequisitoMateriaId])
  @@map("seriacion")
}

model HistorialAcademico {
  id          Int       @id @default(autoincrement())
  aspiranteId Int
  aspirante   Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId   Int
  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  calificacion Float?
  tipoExamen  String?   @default("F")
  estatus     String    @default("CURSANDO")
  periodo     String?

  @@unique([aspiranteId, materiaId])
  @@map("historial_academico")
}

// ==========================================
// MÓDULO CAE
// ==========================================

model MateriaInscrita {
  id          Int       @id @default(autoincrement())
  aspiranteId Int
  aspirante   Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  materiaId   Int
  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  estatus     String    @default("Cursando")
  creadoEn    DateTime  @default(now())

  @@unique([aspiranteId, materiaId])
  @@map("materia_inscrita")
}
